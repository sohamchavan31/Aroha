# Copy to .env (gitignored) and fill in. Used by `docker compose up` / `docker run --env-file`.
# No quotes around values.

# Neon Postgres — JDBC form: jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Flask AI service. From inside Docker, your PC is host.docker.internal.
AROHA_AI_URL=http://host.docker.internal:5000
AI_INTERNAL_KEY=
