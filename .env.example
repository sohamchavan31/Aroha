# Copy to .env (never committed) and fill in. docker-compose.yml reads it.
# No quotes around values.

# ── Database ──────────────────────────────────────────────────────────────
# Neon (recommended: managed, backed up, same DB wherever the app runs):
#   DB_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
# Local Postgres (--profile localdb):
#   DB_URL=jdbc:postgresql://db:5432/aroha
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── Sign-in ───────────────────────────────────────────────────────────────
# A long random string. Changing it signs everyone out.
# PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# ── Email (sign-up and password-reset codes) ─────────────────────────────
# The Google Workspace account that sends them, and an App Password for it
# (Google Account → Security → 2-Step Verification on → App passwords).
# Leave empty in dev: codes are written to the backend log instead.
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Cloudflare Tunnel (--profile tunnel) ─────────────────────────────────
# Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=

# ── AI coach (--profile ai) ───────────────────────────────────────────────
# Shared secret between the backend and the AI service: any random string.
AI_INTERNAL_KEY=
OLLAMA_MODEL=llama3.2

# Host port for the backend (change if 8080 is taken on this machine).
BACKEND_PORT=8080
